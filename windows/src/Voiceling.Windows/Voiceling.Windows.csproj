<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>voiceling</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets/voiceling.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Voiceling.Polish/Voiceling.Polish.csproj" />
    <ProjectReference Include="../Voiceling.Core/Voiceling.Core.csproj" />
    <ProjectReference Include="../Voiceling.Speech/Voiceling.Speech.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Resource Include="Assets/voiceling.ico" />
    <EmbeddedResource Include="Assets/Sounds/*.wav" />
    <Content Include="../../../LICENSE"><Link>LICENSE.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="../../THIRD-PARTY-NOTICES.md"><Link>THIRD-PARTY-NOTICES.md</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="../../THIRD-PARTY-LICENSES.txt"><Link>THIRD-PARTY-LICENSES.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
